@model ErrorViewModel
@{
    ViewData["Title"] = "Something went wrong";
}

<div class="text-center py-5">
    <h1 class="h3">Sorry, something went wrong on our side</h1>
    <p class="text-muted">The problem has been logged. Please try again in a moment.</p>
    @if (Model.ShowRequestId)
    {
        <p class="small text-muted">If you contact support, quote reference <code>@Model.RequestId</code>.</p>
    }
    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Back to the portal</a>
</div>
