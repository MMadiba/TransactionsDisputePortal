@model PagerViewModel
@if (Model.TotalPages > 1)
{
    <nav aria-label="Pages" class="d-flex flex-wrap justify-content-between align-items-center gap-2">
        <span class="text-muted small">Page @Model.Page of @Model.TotalPages · @Model.TotalCount results</span>
        <ul class="pagination mb-0">
            <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                <a class="page-link" asp-action="@Model.Action" asp-all-route-data="@Model.For(Model.Page - 1)!">Previous</a>
            </li>
            @for (var p = Math.Max(1, Model.Page - 2); p <= Math.Min(Model.TotalPages, Model.Page + 2); p++)
            {
                <li class="page-item @(p == Model.Page ? "active" : "")">
                    <a class="page-link" asp-action="@Model.Action" asp-all-route-data="@Model.For(p)!" aria-current="@(p == Model.Page ? "page" : null)">@p</a>
                </li>
            }
            <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                <a class="page-link" asp-action="@Model.Action" asp-all-route-data="@Model.For(Model.Page + 1)!">Next</a>
            </li>
        </ul>
    </nav>
}
