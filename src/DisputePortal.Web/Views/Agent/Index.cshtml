@model DisputesIndexViewModel
@{
    ViewData["Title"] = "Dispute queue";
    var pagerRoute = new Dictionary<string, string?> { ["filter"] = Model.Filter.ToString() };
}

<div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-3">
    <div>
        <h1 class="h3 mb-1">Dispute queue</h1>
        <p class="text-muted mb-0">
            @(Model.Filter == DisputeFilter.Open ? "Open disputes, oldest first. Pick one up to start the review." : "Most recently updated first.")
        </p>
    </div>
    <div class="btn-group" role="group" aria-label="Filter disputes">
        @foreach (var f in Enum.GetValues<DisputeFilter>())
        {
            <a class="btn @(f == Model.Filter ? "btn-primary" : "btn-outline-primary")" asp-action="Index" asp-route-filter="@f">@Display.Filter(f)</a>
        }
    </div>
</div>

@if (Model.Result.TotalCount == 0)
{
    <div class="card card-body text-center text-muted py-5">Nothing here. Nice work.</div>
}
else
{
    <div class="card shadow-sm mb-3">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Reference</th>
                        <th scope="col">Raised</th>
                        <th scope="col">Customer</th>
                        <th scope="col">Transaction</th>
                        <th scope="col">Reason</th>
                        <th scope="col">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model.Result.Items)
                    {
                        <tr>
                            <td class="text-nowrap"><a asp-action="Details" asp-route-id="@d.Id" class="fw-semibold">@d.Reference</a></td>
                            <td class="text-nowrap">@Clock.FormatDate(d.CreatedAtUtc)</td>
                            <td>@d.CustomerName</td>
                            <td>@d.Merchant <span class="text-muted text-nowrap">· @Money.Format(d.Amount, d.Currency)</span></td>
                            <td class="small">@Display.Reason(d.Reason)</td>
                            <td><span class="badge @Display.StatusBadge(d.Status)">@Display.AgentStatus(d.Status)</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <partial name="_Pager" model="PagerViewModel.Create(Model.Result, pagerRoute)" />
}
