@model int
@{
    var (title, message) = Model switch
    {
        404 => ("We couldn't find that page", "It may have moved, or it might belong to a different account."),
        403 => ("You don't have access to that", "If you think you should, please contact support."),
        429 => ("Slow down a little", "You've made a lot of requests in a short time. Please wait a minute and try again."),
        _ => ("Something went wrong", "Please try again in a moment.")
    };
    ViewData["Title"] = title;
}

<div class="text-center py-5">
    <p class="display-4 text-muted">@Model</p>
    <h1 class="h3">@title</h1>
    <p class="text-muted">@message</p>
    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Back to the portal</a>
</div>
