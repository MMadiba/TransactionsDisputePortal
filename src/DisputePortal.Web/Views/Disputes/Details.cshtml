@model DisputeDetailsViewModel
@{
    var d = Model.Dispute;
    ViewData["Title"] = $"Dispute {d.Reference}";
    ViewData["Audience"] = Audience.Customer;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">My disputes</a></li>
        <li class="breadcrumb-item active" aria-current="page">@d.Reference</li>
    </ol>
</nav>

<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

<partial name="_DisputeOverview" model="d" view-data="ViewData" />

@if (d.IsOpen)
{
    <div class="card border-danger-subtle mt-4">
        <div class="card-body">
            <h2 class="h6">Changed your mind?</h2>
            <p class="small text-muted">If you've sorted this out with the merchant, you can withdraw the dispute. You'll be able to raise a new one later if you need to.</p>
            <details>
                <summary class="btn btn-outline-danger btn-sm">Withdraw this dispute</summary>
                <form method="post" asp-action="Withdraw" asp-route-id="@d.Id" class="mt-3">
                    <p class="mb-2">Are you sure you want to withdraw <strong>@d.Reference</strong>?</p>
                    <button type="submit" class="btn btn-danger btn-sm">Yes, withdraw it</button>
                </form>
            </details>
        </div>
    </div>
}
