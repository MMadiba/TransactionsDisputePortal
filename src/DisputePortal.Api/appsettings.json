{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=data/disputeportal.db"
  },
  "Database": {
    "ApplyMigrationsOnStartup": true
  },
  "Disputes": {
    "WindowDays": 120
  },
  "Portal": {
    "TimeZone": "Africa/Johannesburg"
  },
  "Jwt": {
    "Issuer": "dispute-portal",
    "Audience": "dispute-portal-api",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "DemoData": {
    "Enabled": false,
    "Password": ""
  },
  "OpenApi": {
    "Enabled": false
  },
  "DataProtection": {
    "KeysPath": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
